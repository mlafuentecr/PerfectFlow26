# Learn more https://docs.expo.dev/build-reference/easignore/

# dependencies
node_modules/
/app/node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
google-services.json
/app/credentials.json
/app/credentials/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/android
/ios
/app/android
/app/ios

# Artifacts and store media outside the Expo project
app-release/

# Sensitive OAuth client secret backup (do not commit)
bkup/client_secret_*.json

# EAS needs this local Firebase Android config during prebuild, but it should
# stay out of git.
!google-services.json
!/app/google-services.json
